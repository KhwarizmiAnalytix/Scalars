# Every header in this repository uses #pragma once (a deliberate, universal
# convention, not an oversight) — hence -portability-avoid-pragma-once below.
# That check only becomes reachable once --header-filter actually matches
# include/|src/ (see cmake/clang_tidy.cmake); it used to match nothing here.
#
# math/complex_math.h, math/complex_utils.h, and math/scalar_helper_functions.h
# deliberately inject function overloads into namespace std so that generic
# code can call std::op(...) uniformly across scalar, complex, and GPU scalar
# types — hence -bugprone-std-namespace-modification below.
---
Checks: >
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  readability-braces-around-statements,
  readability-identifier-naming,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-std-namespace-modification,
  -portability-avoid-pragma-once
WarningsAsErrors: ''
HeaderFilterRegex: ''
FormatStyle: none
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: lower_case
  - key: readability-identifier-naming.StructCase
    value: lower_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantCase
    value: lower_case
  - key: readability-identifier-naming.TypeAliasCase
    value: lower_case
