@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

# Scalars' GPU backend (set at configure time) determines which toolkit a
# consumer of find_package(Scalars) also needs on CMAKE_PREFIX_PATH.
if("@SCALARS_GPU_BACKEND@" STREQUAL "cuda")
    find_dependency(CUDAToolkit)
elseif("@SCALARS_GPU_BACKEND@" STREQUAL "hip")
    find_dependency(hip)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ScalarsTargets.cmake")
check_required_components(Scalars)
