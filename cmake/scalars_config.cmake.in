@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

# Scalars' GPU backend (set at configure time) determines which toolkit a
# consumer of find_package(Scalars) also needs on CMAKE_PREFIX_PATH.
if("@SCALARS_GPU_BACKEND@" STREQUAL "cuda")
    find_dependency(CUDAToolkit)
elseif("@SCALARS_GPU_BACKEND@" STREQUAL "hip")
    find_dependency(hip)
endif()

# Sleef::sleef and MKL::MKL are linked PUBLIC by simd.cmake (and SVML::SVML
# too, as of the fix below), so ScalarsTargets.cmake below requires each of
# these imported targets to already exist before it is included. Previously
# only CUDA/HIP were re-found here, so an installed package with SLEEF (the
# default on non-Apple AArch64) or MKL enabled failed at this include() with
# "target ... links to target ... which does not exist".
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/Modules")

if(@SCALARS_HAS_SVML@)
    find_dependency(SVML)
endif()
if(@SCALARS_HAS_MKL@)
    find_dependency(MKL)
endif()
if(@SCALARS_HAS_SLEEF@)
    # SLEEF's own install exports sleef::sleef (see
    # ThirdParty/sleef/CMakeLists.txt), but Scalars links against the plain
    # "sleef" target name (scalars_dependencies.cmake aliases it locally as
    # Sleef::sleef, which CMake resolves to the underlying "sleef" name when
    # recording Scalars' own exported link requirements). Recreate that name.
    find_dependency(sleef)
    if(TARGET sleef::sleef AND NOT TARGET sleef)
        add_library(sleef ALIAS sleef::sleef)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ScalarsTargets.cmake")
check_required_components(Scalars)
